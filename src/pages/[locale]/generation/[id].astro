---
export const prerender = true

import ListerFilters from '@/components/ListerFilters.astro'
import ListerSkeleton from '@/components/ListerSkeleton.astro'
import { PokemonLister } from '@/components/PokemonLister'
import Layout from '@/layouts/Layout.astro'
import { GENERATIONS } from '@/utils/generations'
import { getI18n, locales } from '@/utils/i18n'
import { getAllPokemon, toSummary, typesInGeneration } from '@/utils/pokemon'

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    GENERATIONS.map((gen) => ({ params: { locale, id: String(gen.id) } }))
  )
}

const { locale: localeParam, id = '' } = Astro.params
const { locale, t } = getI18n(localeParam)

const generation = GENERATIONS.find((gen) => gen.id === Number(id))
if (!generation) {
  return Astro.redirect(`/${locale}/404`)
}

const all = await getAllPokemon()
const pokemon = all
  .filter((p) => p.isDefault && p.generation === generation.id)
  .map(toSummary)
---

<Layout title={`${t.home.generation} ${generation.roman} - ${generation.region} ${t.pages.region}`} locale={locale}>
  <PokemonLister client:only="react" pokemon={pokemon} locale={locale}>
    <ListerFilters slot="filters" locale={locale} types={typesInGeneration(all, generation.id)} />
    <ListerSkeleton slot="fallback" locale={locale} />
  </PokemonLister>
</Layout>
