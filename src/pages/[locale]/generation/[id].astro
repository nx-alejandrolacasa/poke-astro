---
export const prerender = true

import ListerFilters from '@/components/ListerFilters.astro'
import ListerSkeleton from '@/components/ListerSkeleton.astro'
import { PokemonLister } from '@/components/PokemonLister'
import Layout from '@/layouts/Layout.astro'
import { GENERATIONS } from '@/utils/generations'
import { getI18n, locales } from '@/utils/i18n'
import { getAllPokemon, toSummary } from '@/utils/pokemon'
import { interpolate } from '@/utils/translations'

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    GENERATIONS.map((gen) => ({ params: { locale, id: String(gen.id) } }))
  )
}

const { locale: localeParam, id = '' } = Astro.params
const { locale, t } = getI18n(localeParam)

const generation = GENERATIONS.find((gen) => gen.id === Number(id))
if (!generation) {
  return Astro.redirect(`/${locale}/404`)
}

const pokemon = (await getAllPokemon())
  .filter((p) => p.isDefault && p.generation === generation.id)
  .map(toSummary)

const title = `${t.home.generation} ${generation.roman}`
const subtitle = `${generation.region} · ${interpolate(t.pages.speciesCount, { count: pokemon.length })}`
---

<Layout title={`${title} - ${generation.region} ${t.pages.region}`} locale={locale}>
  <PokemonLister client:only="react" pokemon={pokemon} locale={locale}>
    <ListerFilters slot="filters" locale={locale} />
    <div slot="banner" class="rounded-2xl border-2 border-black/[0.06] dark:border-white/[0.08] bg-gradient-to-br from-primary-50 to-surface-sunken p-6 md:p-8 dark:from-dark-raised dark:to-dark-surface">
      <h1 class="font-bold text-2xl text-ink tracking-tight md:text-3xl dark:text-dark-ink">{title}</h1>
      <p class="font-medium text-ink-muted text-sm dark:text-dark-ink-muted">{subtitle}</p>
    </div>
    <ListerSkeleton
      slot="fallback"
      banner="generation"
      locale={locale}
      bannerTitle={title}
      bannerSubtitle={subtitle}
    />
  </PokemonLister>
</Layout>
