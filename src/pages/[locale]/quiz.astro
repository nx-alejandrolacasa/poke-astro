---
export const prerender = true

import { BackButton } from '@/components/BackButton'
import PlaySkeleton from '@/components/PlaySkeleton.astro'
import { WhosThatPokemon } from '@/components/WhosThatPokemon'
import Layout from '@/layouts/Layout.astro'
import { getI18n, getLocalePaths } from '@/utils/i18n'

export function getStaticPaths() {
  return getLocalePaths()
}

const { locale: localeParam } = Astro.params
const { locale, t } = getI18n(localeParam)
---

<Layout title={t.quiz.title} locale={locale} description={t.quiz.subtitle}>
  <div class="space-y-6">
    <div class="flex items-center gap-2 border-black/[0.06] border-b pb-3 dark:border-white/[0.08]">
      <BackButton client:load locale={locale} />
    </div>
    <div class="text-center">
      <h1 class="pokemon-title text-2xl md:text-4xl">{t.quiz.title}</h1>
      <p class="mt-2 text-ink-muted text-sm dark:text-dark-ink-muted">{t.quiz.subtitle}</p>
    </div>
    <WhosThatPokemon client:only="react" locale={locale}>
      <PlaySkeleton slot="fallback" />
    </WhosThatPokemon>
  </div>
</Layout>
