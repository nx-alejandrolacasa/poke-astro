---
export const prerender = true

import { BackButton } from '@/components/BackButton'
import PlaySkeleton from '@/components/PlaySkeleton.astro'
import { StatBattle } from '@/components/StatBattle'
import Layout from '@/layouts/Layout.astro'
import { getI18n, getLocalePaths } from '@/utils/i18n'

export function getStaticPaths() {
  return getLocalePaths()
}

const { locale: localeParam } = Astro.params
const { locale, t } = getI18n(localeParam)
---

<Layout title={t.battle.title} locale={locale} description={t.battle.subtitle}>
  <div class="space-y-6">
    <div class="flex items-center gap-2">
      <BackButton client:load locale={locale} />
    </div>
    <StatBattle client:only="react" locale={locale}>
      <PlaySkeleton slot="fallback" />
    </StatBattle>
  </div>
</Layout>
