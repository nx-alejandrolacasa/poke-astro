---
export const prerender = true

import PlaySkeleton from '@/components/PlaySkeleton.astro'
import { TeamBuilder } from '@/components/TeamBuilder'
import Layout from '@/layouts/Layout.astro'
import { getI18n, getLocalePaths } from '@/utils/i18n'

export function getStaticPaths() {
  return getLocalePaths()
}

const { locale: localeParam } = Astro.params
const { locale, t } = getI18n(localeParam)
---

<Layout title={t.team.title} locale={locale} description={t.team.subtitle}>
  <div class="space-y-6">
    <div class="text-center">
      <h1 class="pokemon-title text-2xl md:text-4xl">{t.team.title}</h1>
      <p class="mt-2 text-ink-muted text-sm dark:text-dark-ink-muted">{t.team.subtitle}</p>
    </div>
    <TeamBuilder client:only="react" locale={locale}>
      <PlaySkeleton slot="fallback" />
    </TeamBuilder>
  </div>
</Layout>
