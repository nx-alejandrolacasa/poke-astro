---
export const prerender = true

import PlaySkeleton from '@/components/games/PlaySkeleton.astro'
import { TeamBuilder } from '@/components/games/TeamBuilder'
import Layout from '@/layouts/Layout.astro'
import { getI18n, getLocalePaths } from '@/utils/i18n'

export function getStaticPaths() {
  return getLocalePaths()
}

const { locale: localeParam } = Astro.params
const { locale, t } = getI18n(localeParam)
---

<Layout title={t.team.title} locale={locale} description={t.team.subtitle}>
  <h1 class="sr-only">{t.team.title}</h1>
  <TeamBuilder client:only="react" locale={locale}>
    <PlaySkeleton slot="fallback" />
  </TeamBuilder>
</Layout>
