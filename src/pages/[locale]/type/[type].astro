---
export const prerender = true

import ListerFilters from '@/components/ListerFilters.astro'
import ListerSkeleton from '@/components/ListerSkeleton.astro'
import { PokemonLister } from '@/components/PokemonLister'
import Layout from '@/layouts/Layout.astro'
import { getI18n, locales } from '@/utils/i18n'
import {
  generationsWithType,
  getAllPokemon,
  getPokemonName,
  POKEMON_TYPES,
  toSummary,
} from '@/utils/pokemon'

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    POKEMON_TYPES.map((type) => ({ params: { locale, type } }))
  )
}

const { locale: localeParam, type = '' } = Astro.params
const { locale, t } = getI18n(localeParam)

const all = await getAllPokemon()
const pokemon = all.filter((p) => p.types.includes(type)).map(toSummary)
const typeName = t.types[type as keyof typeof t.types] || getPokemonName(type)
---

<Layout title={`${typeName} - ${t.pages.typeTitle}`} locale={locale}>
  <PokemonLister client:only="react" pokemon={pokemon} locale={locale}>
    <ListerFilters slot="filters" locale={locale} generations={generationsWithType(all, type)} />
    <ListerSkeleton slot="fallback" locale={locale} />
  </PokemonLister>
</Layout>
