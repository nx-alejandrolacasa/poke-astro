---
export const prerender = true

import { ComparePokemon } from '@/components/ComparePokemon'
import PlaySkeleton from '@/components/PlaySkeleton.astro'
import Layout from '@/layouts/Layout.astro'
import { getI18n, getLocalePaths } from '@/utils/i18n'

export function getStaticPaths() {
  return getLocalePaths()
}

const { locale: localeParam } = Astro.params
const { locale, t } = getI18n(localeParam)
---

<Layout title={t.compare.title} locale={locale} description={t.compare.subtitle}>
  <h1 class="sr-only">{t.compare.title}</h1>
  <ComparePokemon client:only="react" locale={locale}>
    <PlaySkeleton slot="fallback" />
  </ComparePokemon>
</Layout>
