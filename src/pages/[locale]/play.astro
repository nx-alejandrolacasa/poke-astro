---
export const prerender = true

import Layout from '@/layouts/Layout.astro'
import { getI18n, getLocalePaths } from '@/utils/i18n'
import { officialArtworkUrl, optimizedImageUrl } from '@/utils/pokemon'

export function getStaticPaths() {
  return getLocalePaths()
}

const { locale: localeParam } = Astro.params
const { locale, t } = getI18n(localeParam)

const cards = [
  {
    href: `/${locale}/quiz`,
    title: t.quiz.title,
    subtitle: t.quiz.subtitle,
    mascot: 25,
    color: '#f4d67b',
  },
  {
    href: `/${locale}/compare`,
    title: t.compare.title,
    subtitle: t.compare.subtitle,
    mascot: 150,
    color: '#997a96',
  },
  {
    href: `/${locale}/team`,
    title: t.team.title,
    subtitle: t.team.subtitle,
    mascot: 448,
    color: '#6896a8',
  },
  {
    href: `/${locale}/battle`,
    title: t.battle.title,
    subtitle: t.battle.subtitle,
    mascot: 107,
    color: '#d46a6a',
  },
]
---

<Layout title={t.play.title} locale={locale}>
  <div class="space-y-8">
    <h1 class="pokemon-title pt-6 text-center text-3xl md:text-5xl">{t.play.title}</h1>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {cards.map((card) => (
        <a
          href={card.href}
          class="group flex flex-col items-center gap-3 rounded-3xl bg-white p-6 text-center transition-all hover:-translate-y-1 active:scale-[0.98] dark:bg-dark-surface"
          style={`border: 2px solid ${card.color}; background-image: radial-gradient(circle at 50% 30%, ${card.color}40, transparent 65%)`}
        >
          <img
            src={optimizedImageUrl(officialArtworkUrl(card.mascot), 128)}
            alt=""
            class="h-28 w-28 object-contain transition-transform group-hover:scale-110"
            loading="lazy"
          />
          <h2 class="font-bold text-ink text-xl dark:text-dark-ink">{card.title}</h2>
          <p class="text-ink-muted text-sm dark:text-dark-ink-muted">{card.subtitle}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
