---
export const prerender = true

import { BackButton } from '@/components/BackButton'
import PlaySkeleton from '@/components/PlaySkeleton.astro'
import { StatSlots } from '@/components/StatSlots'
import Layout from '@/layouts/Layout.astro'
import { getI18n, getLocalePaths } from '@/utils/i18n'

export function getStaticPaths() {
  return getLocalePaths()
}

const { locale: localeParam } = Astro.params
const { locale, t } = getI18n(localeParam)
---

<Layout title={t.slots.title} locale={locale} description={t.slots.subtitle}>
  <div class="space-y-6">
    <div class="flex items-center gap-2">
      <BackButton client:load locale={locale} />
    </div>
    <div class="text-center">
      <h1 class="pokemon-title text-2xl md:text-4xl">{t.slots.title}</h1>
      <p class="mt-2 text-ink-muted text-sm dark:text-dark-ink-muted">{t.slots.subtitle}</p>
    </div>
    <StatSlots client:only="react" locale={locale}>
      <PlaySkeleton slot="fallback" />
    </StatSlots>
  </div>
</Layout>
