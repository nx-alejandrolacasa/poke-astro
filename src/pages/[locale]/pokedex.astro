---
export const prerender = true

import ListerFilters from '@/components/ListerFilters.astro'
import ListerSkeleton from '@/components/ListerSkeleton.astro'
import { PokemonLister } from '@/components/PokemonLister'
import Layout from '@/layouts/Layout.astro'
import { getI18n, getLocalePaths } from '@/utils/i18n'
import { getAllPokemon, toSummary } from '@/utils/pokemon'

export function getStaticPaths() {
  return getLocalePaths()
}

const { locale: localeParam } = Astro.params
const { locale, t } = getI18n(localeParam)

const pokemon = (await getAllPokemon()).map(toSummary)
---

<Layout title={t.header.pokedex} locale={locale}>
  <PokemonLister client:only="react" pokemon={pokemon} locale={locale}>
    <ListerFilters slot="filters" locale={locale} />
    <ListerSkeleton slot="fallback" locale={locale} />
  </PokemonLister>
</Layout>
