---
// Static twin of BackButton.tsx for skeletons: same look, functional before
// hydration. A skeleton only shows mid-navigation, so there is always a page
// to go back to; the label names the most likely one.
import { BACK_LINK_CLASS } from '@/components/detail/BackButton'
import type { Locale } from '@/utils/i18n'
import { translations } from '@/utils/translations'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translations[locale]
---

<button type="button" onclick="history.back()" class={BACK_LINK_CLASS}>
  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
  </svg>
  <span>{t.header.pokedex}</span>
</button>
