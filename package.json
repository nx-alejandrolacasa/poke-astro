{
  "name": "poke-astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=1 astro dev",
    "start": "ASTRO_DEV_BACKGROUND=1 astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "biome check .",
    "check:types": "astro sync && tsc --noEmit --runExternalCode",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.1",
    "@astrojs/vercel": "11.0.16",
    "@fontsource/dela-gothic-one": "5.3.0",
    "@tanstack/react-virtual": "3.14.23",
    "@tanstack/redact": "0.2.0",
    "@vercel/analytics": "2.0.1",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "vite": "$vite"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@biomejs/biome": "2.6.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.1.0-beta",
    "vite": "8.3.5"
  }
}
